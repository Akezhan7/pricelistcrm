# ==========================================
# База данных PostgreSQL
# ==========================================
DB_HOST=localhost
DB_PORT=5432
DB_NAME=crm3_db
DB_USER=postgres
DB_PASSWORD=your_secure_password_here

# Логирование SQL запросов (true для отладки, false для production)
DB_LOGGING=false

# ==========================================
# JWT Аутентификация
# ==========================================
# ВАЖНО: Сгенерируйте сильный секретный ключ для production!
# Пример генерации: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=your-super-secret-jwt-key-here-change-in-production-minimum-32-chars
JWT_EXPIRES_IN=7d

# ==========================================
# Сервер
# ==========================================
PORT=5000
NODE_ENV=development

# ==========================================
# CORS - URL клиентского приложения
# ==========================================
# Для разработки: http://localhost:3000
# Для production: https://your-domain.com
CLIENT_URL=http://localhost:3000

# ==========================================
# Файлы и загрузки
# ==========================================
UPLOAD_DIR=./uploads
MAX_FILE_SIZE=5000000

# ==========================================
# Cloudinary (для production хранения изображений)
# ==========================================
# Опционально: для хранения изображений в облаке
# Получите бесплатный аккаунт на https://cloudinary.com
# CLOUDINARY_CLOUD_NAME=your_cloud_name
# CLOUDINARY_API_KEY=your_api_key
# CLOUDINARY_API_SECRET=your_api_secret

# ==========================================
# Администратор по умолчанию
# ==========================================
DEFAULT_ADMIN_EMAIL=admin@example.com
DEFAULT_ADMIN_PASSWORD=change_this_password_in_production
DEFAULT_ADMIN_NAME=Администратор

# ==========================================
# Миграции и Бэкапы
# ==========================================
# Автоматически запускать миграции при старте сервера
AUTO_MIGRATE=true

# Включить автоматическое резервное копирование
BACKUP_ENABLED=true

# Расписание бэкапов (Cron формат): каждый день в 3:00
# Формат: минута час день месяц день_недели
BACKUP_SCHEDULE=0 3 * * *

# Количество дней хранения бэкапов (старые удаляются автоматически)
BACKUP_RETENTION_DAYS=7

# ==========================================
# Безопасность
# ==========================================
# Запретить sync({ force: true }) в production
ALLOW_FORCE_SYNC=false

# ==========================================
# Миграция (опционально)
# ==========================================
# Если нужно мигрировать данные из SQLite:
# SQLITE_PATH=./database.sqlite

# ==========================================
# ИНСТРУКЦИИ ПО НАСТРОЙКЕ
# ==========================================
# 
# ЛОКАЛЬНАЯ РАЗРАБОТКА:
# 1. Скопируйте этот файл: cp .env.example .env
# 2. Установите PostgreSQL локально
# 3. Обновите DB_PASSWORD на ваш пароль
# 4. Запустите: npm run init-db
# 5. Запустите: npm run dev
#
# PRODUCTION ДЕПЛОЙ:
# 1. Сгенерируйте сильный JWT_SECRET (минимум 32 символа)
# 2. Обновите CLIENT_URL на URL вашего фронтенда
# 3. Обновите DB_HOST на хост вашей БД
# 4. Смените DEFAULT_ADMIN_PASSWORD на сильный пароль
# 5. Установите NODE_ENV=production
# 6. Настройте Cloudinary для загрузки изображений (опционально)
#
# ХОСТИНГИ:
# - Railway: автоматически создаст PostgreSQL, просто добавьте переменные
# - Render: создайте PostgreSQL сервис, скопируйте DATABASE_URL
# - Vercel: для backend не подходит, используйте для frontend
# - Heroku: добавьте Heroku Postgres addon
